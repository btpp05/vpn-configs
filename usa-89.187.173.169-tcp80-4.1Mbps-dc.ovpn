client
dev tun
proto tcp
nobind
resolv-retry infinite
persist-key
persist-tun
remote-cert-tls server
ignore-unknown-option data-ciphers
cipher AES-256-GCM
data-ciphers AES-256-GCM
auth SHA512
pull-filter ignore "ping"
pull-filter ignore "ping-restart"
pull-filter ignore "keepalive"
keepalive 10 20
server-poll-timeout 10
connect-retry 1 2
connect-retry-max 1
verb 3
# RiseupVPN gateway: vpn22-mia.riseup.net, Miami
remote 89.187.173.169 80
remote 89.187.173.169 1194
remote 89.187.173.169 53
remote-random

